# Environment for scripts/demo.sh — copy to .env.demo (gitignored) and fill in.
# Everything here targets Hedera testnet; the addresses come from contracts/deployments/296.json.

CHAIN_ID=296
RPC_URL=https://testnet.hashio.io/api
DISCOUNT_ORACLE=0xb6d7F1e018195E0000eb0EE017E36c61113e9010
INVOICE_MARKET=0xe7f89692940f5BCc30096cd48f360F2144155962

# Signs discount quotes. Must be the address the oracle knows as `signer`.
QUOTE_SIGNER_PK=

# Writes eligibility on every bond. Holds COMPLIANCE_ROLE; keep it separate from the signer.
COMPLIANCE_OPERATOR_PK=

# HCS audit trail. Without these, attestations answer 503 and the rest still works.
HEDERA_OPERATOR_ID=0.0.7162116
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=0.0.10388277

# Sumsub sandbox. Without these, the KYC routes answer 503.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# World Selfie Check. WORLD_APP_ID also reaches the browser and is what shows the wizard step.
WORLD_APP_ID=app_96e61382eeeabdae6887e00434ab8edf
WORLD_RP_ID=rp_4e66ef1ffe9c2f54
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=sandbox
