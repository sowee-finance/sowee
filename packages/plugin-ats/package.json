{
  "name": "@sowee/plugin-ats",
  "version": "0.1.0",
  "description": "Sowee plugin for Hedera Asset Tokenization Studio: deploy invoice bonds via the ATS factory and drive compliance (KYC, control list, freeze, pause) and lifecycle (snapshots, redemption, controller transfers) on the security diamond",
  "keywords": [
    "hedera",
    "asset-tokenization-studio",
    "ats",
    "security-token",
    "bond",
    "invoice-financing",
    "rwa",
    "compliance"
  ],
  "license": "Apache-2.0",
  "author": "Sowee Finance",
  "homepage": "https://github.com/sowee-finance/sowee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sowee-finance/sowee.git",
    "directory": "packages/plugin-ats"
  },
  "bugs": {
    "url": "https://github.com/sowee-finance/sowee/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/regression",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression": "vitest run tests/regression"
  },
  "dependencies": {
    "@sowee/core": "workspace:^",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
