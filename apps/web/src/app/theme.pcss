/* Tailwind v4 design tokens. Kept out of globals.css because biome's CSS parser rejects the
   `@theme` directive; Tailwind resolves this relative import itself. */

@theme inline {
  --font-sans: var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-geist-mono), ui-monospace, SFMono-Regular, Menlo, monospace;
}

@theme {
  --color-ink: #16181a;
  --color-body: #3f4447;
  /* WCAG AA: soft >= 4.5 on shade (#f5f5f3), faint >= 4.5 on #fafaf8 */
  --color-soft: #676c70;
  --color-faint: #6f747a;
  --color-line: #e9e9e7;
  --color-shade: #f5f5f3;
  --color-hero: #0c2d1d;
  --color-pos: #007a4b;
  --color-neg: #d53f3f;
}
