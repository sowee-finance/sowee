# Chain the UI reads from and asks the wallet to join. 296 = Hedera testnet (default), 31337 = anvil.
NEXT_PUBLIC_CHAIN_ID=296

# Origin of the Go API (apps/api): signed quotes, HCS attestations and KYC. Also allowed in the CSP.
NEXT_PUBLIC_API_URL=http://localhost:8080

# HCS topic the bond page's audit-trail panel reads through the public mirror node (Hedera only).
NEXT_PUBLIC_HCS_TOPIC_ID=0.0.10388277

# World app id. Unset (default) hides the Selfie Check step of the KYC wizard; set it once
# Selfie Check access is granted and wire IDKit into src/components/selfie-check-step.tsx.
# NEXT_PUBLIC_WORLD_APP_ID=app_...
