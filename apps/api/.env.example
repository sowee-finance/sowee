# HTTP port
PORT=8080

# EIP-712 domain chainId. 296 = Hedera testnet.
CHAIN_ID=296

# Deployed DiscountOracle address (EIP-712 verifyingContract). See contracts/deployments.
DISCOUNT_ORACLE=

# Hex private key of the quote signer. Its address must equal DiscountOracle.signer().
# Never commit a real key. For local runs generate a throwaway one: openssl rand -hex 32
QUOTE_SIGNER_PK=

# Hedera Consensus Service audit trail. Leave HCS_TOPIC_ID empty on first run: the API creates a
# topic, logs it, and you pin it here. Without operator credentials anchoring is disabled (503).
HCS_TOPIC_ID=0.0.10388277
HEDERA_OPERATOR_ID=0.0.7162116
HEDERA_OPERATOR_KEY=
MIRROR_URL=https://testnet.mirrornode.hedera.com

# Paid market-insights endpoint (x402 v2, exact scheme, settled by the Blocky402 facilitator).
# Amount is in USDC base units: 10000 = 0.01 USDC. PAY_TO defaults to HEDERA_OPERATOR_ID.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_ASSET=0.0.429274
X402_PAY_TO=
X402_AMOUNT=10000

# Live market state for insights (empty until the contracts are deployed)
RPC_URL=https://testnet.hashio.io/api
INVOICE_MARKET=

# KYC (Sumsub sandbox). Level and questionnaire ids live in the Sumsub dashboard; KYC endpoints
# answer 503 without the token + secret. The webhook secret is set on the Sumsub webhook.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL=sowee-investor
SUMSUB_QUESTIONNAIRE_ID=sowee-investor-suitability
SUMSUB_WEBHOOK_SECRET=
# Holds COMPLIANCE_ROLE on every bond (the deployer by default); defaults to QUOTE_SIGNER_PK.
COMPLIANCE_OPERATOR_PK=

# World ID Selfie Check (anti-sybil signal in front of KYC). Off unless all three are set.
# Access is feature-flagged per app: request it from World, then copy the ids from the Developer Portal.
WORLD_APP_ID=app_96e61382eeeabdae6887e00434ab8edf
WORLD_RP_ID=rp_4e66ef1ffe9c2f54
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=sowee-selfie-check
WORLD_ENVIRONMENT=sandbox

# Demo faucet (USDC from the treasury key to Selfie-verified wallets) and tiered rate limits.
USDC_ADDRESS=0x0000000000000000000000000000000000068cDa
FAUCET_USDC_AMOUNT=1000000
FAUCET_COOLDOWN=24h
# Only set behind a reverse proxy you control; otherwise X-Forwarded-For is ignored.
TRUSTED_PROXY=false
RATE_BASE_PER_MIN=30
RATE_VERIFIED_PER_MIN=300
