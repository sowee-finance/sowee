# JSON-RPC endpoints
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# Deployer / compliance operator (never commit the real value)
DEPLOYER_PK=0x

# Address allowed to sign EIP-712 discount quotes (the API signer)
QUOTE_SIGNER=0x

# Settlement asset.
# Hedera testnet USDC (HTS 0.0.429274, 6 decimals):
USDC=0x0000000000000000000000000000000000068cDa
# Arc testnet USDC (chain 5042002, 6 decimals): 0x3600000000000000000000000000000000000000

# Optional: keep duties on separate keys. Both default to the deployer.
# COMPLIANCE_OPERATOR=0x   # writes eligibility on every bond (the API's granter)
# TREASURY=0x             # collects the platform fee; must be associated with the HTS token
